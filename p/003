<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>AI Queens — Prompt #003</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
    }

    body {
      min-height: 100vh;
      padding: 24px 12px 50px;

      font-family: Arial, Helvetica, sans-serif;
      color: #5c463d;

      background: transparent;
      position: relative;
    }

    body::before {
      content: "";
      position: fixed;
      inset: -10px;

      background-image: url("../../background.png");
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;

      filter: blur(1px);
      transform: scale(1.01);

      z-index: -1;
    }

    .page {
      width: 100%;
      max-width: 760px;
      margin: 0 auto;
    }

    .main-card {
      background: rgba(255, 250, 247, 0.88);

      border: 1px solid rgba(183, 143, 93, 0.35);
      border-radius: 38px;

      padding: 42px 22px 34px;

      box-shadow:
        0 24px 70px rgba(100, 70, 50, 0.14),
        0 0 35px rgba(191, 151, 94, 0.10);

      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .brand {
      text-align: center;
      margin-bottom: 20px;
    }

    .brand h1 {
      margin: 0;
      color: #a87836;

      font-family: Georgia, "Times New Roman", serif;
      font-style: italic;

      font-size: clamp(24px, 4vw, 42px);
      font-weight: 700;
      line-height: 1.25;

      white-space: nowrap;
    }

    .brand-subtitle {
      margin-top: 18px;
      text-align: center;
      color: #9a7a69;

      font-size: 13px;
      letter-spacing: 3px;
      text-transform: uppercase;
      line-height: 1.7;
    }

    .divider {
      width: 42%;
      height: 1px;
      margin: 30px auto 36px;

      background: linear-gradient(
        90deg,
        transparent,
        #c99c57,
        transparent
      );
    }

    .prompt-number {
      text-align: center;
      color: #b08242;

      font-size: 12px;
      font-weight: 800;
      letter-spacing: 2px;

      margin-bottom: 12px;
    }

    .prompt-title {
      margin: 0 0 30px;

      text-align: center;

      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(25px, 5vw, 36px);

      color: #5c463d;
    }

    .prompt-box {
      margin-top: 20px;
      padding: 28px;

      background: rgba(255, 255, 255, 0.66);

      border: 1px solid rgba(191, 151, 94, 0.35);
      border-radius: 24px;

      box-shadow:
        0 10px 28px rgba(92, 70, 61, 0.07);
    }

    .prompt-label {
      margin-bottom: 18px;

      color: #a87029;

      font-size: 13px;
      font-weight: 900;
      letter-spacing: 2px;
    }

    .prompt-text {
      white-space: pre-wrap;

      color: #5c463d;

      font-size: 16px;
      line-height: 1.75;
    }

    .copy-btn {
      display: block;

      width: min(360px, 100%);

      margin: 30px auto 0;
      padding: 17px 24px;

      border: 1px solid #b98745;
      border-radius: 999px;

      background: linear-gradient(
        135deg,
        #c99a55,
        #a86f27
      );

      color: #ffffff;

      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1px;

      cursor: pointer;

      transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
    }

    .copy-btn:hover {
      transform: translateY(-2px);

      box-shadow:
        0 10px 26px rgba(168, 111, 39, 0.24);
    }

    .back-link {
      display: block;
      width: fit-content;

      margin: 34px auto 8px;

      color: #9d6b2d;

      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1px;

      text-decoration: none;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    .footer {
      margin-top: 28px;

      text-align: center;

      color: #a78d80;
      font-size: 11px;
    }

    @media (max-width: 600px) {
      body {
        padding: 12px 8px 30px;
      }

      .main-card {
        padding: 32px 16px 24px;
        border-radius: 26px;
      }

      .brand h1 {
        font-size: clamp(18px, 6vw, 28px);
      }

      .brand-subtitle {
        font-size: 10px;
        letter-spacing: 2px;
      }

      .prompt-box {
        padding: 20px 18px;
        border-radius: 20px;
      }

      .prompt-text {
        font-size: 15px;
        line-height: 1.65;
      }
    }
  </style>
</head>

<body>

  <div class="page">

    <main class="main-card">

      <header class="brand">

        <h1>AI Queens ♛ Stayci &amp; Di</h1>

        <div class="brand-subtitle">
          Official Prompt Collection
        </div>

      </header>

      <div class="divider"></div>

      <div class="prompt-number">
        PROMPT #003
      </div>

      <h2 class="prompt-title">
        Elevator Noir Mirror Selfie
      </h2>


      <section class="prompt-box">

        <div class="prompt-label">
          POSITIVE PROMPT
        </div>

        <div class="prompt-text" id="positivePrompt">Ultra-realistic luxury fashion mirror selfie of an elegant young woman standing in front of a full-length mirror inside a modern minimalist elevator. She wears a black lace corset mini dress with a sheer floral lace bodice, structured boning, sweetheart neckline, and a voluminous satin bubble skirt. Her blonde hair is styled in a sleek, tight low bun with a glossy finish. She wears, a delicate pearl necklace, gold rings, a thin gold bracelet, and carries a small black ruched shoulder bag. She holds a silver smartphone with a marble-pattern case while taking a mirror selfie. One hand rests on the side of her head in a confident pose. Warm indoor lighting creates soft shadows and highlights her glowing bronzed skin. Dark brushed-metal elevator doors, clean white walls, luxury apartment aesthetic, editorial high-fashion photography, old-money elegance, minimalist luxury, photorealistic, ultra detailed, realistic skin texture, HDR, sharp focus, professional full-frame camera, 8K. Vertical 9:16 framing.</div>

      </section>


      <section class="prompt-box">

        <div class="prompt-label">
          NEGATIVE PROMPT
        </div>

        <div class="prompt-text" id="negativePrompt">low quality, blurry, cartoon, CGI, illustration, painting, unrealistic anatomy, extra fingers, deformed hands, distorted face, duplicate limbs, bad proportions, plastic skin, oversaturated colors, watermark, logo, text, artifacts, motion blur, noise, low resolution, poor lighting, messy background, cropped body</div>

      </section>


      <button
        class="copy-btn"
        onclick="copyAllPrompts(this)"
      >
        COPY FULL PROMPT
      </button>


      <a class="back-link" href="../../">
        ← BACK TO PROMPT LIBRARY
      </a>


      <footer class="footer">
        © AI Queens — Stayci &amp; Di
      </footer>

    </main>

  </div>


  <script>

    async function copyAllPrompts(button) {

      const positive =
        document.getElementById("positivePrompt").innerText;

      const negative =
        document.getElementById("negativePrompt").innerText;

      const fullPrompt =
        "POSITIVE PROMPT\n\n" +
        positive +
        "\n\nNEGATIVE PROMPT\n\n" +
        negative;

      const originalText = "COPY FULL PROMPT";

      try {

        await navigator.clipboard.writeText(fullPrompt);

        button.innerText = "COPIED ✓";

        setTimeout(() => {
          button.innerText = originalText;
        }, 1800);

      } catch (error) {

        const textarea =
          document.createElement("textarea");

        textarea.value = fullPrompt;

        document.body.appendChild(textarea);

        textarea.select();

        document.execCommand("copy");

        document.body.removeChild(textarea);

        button.innerText = "COPIED ✓";

        setTimeout(() => {
          button.innerText = originalText;
        }, 1800);

      }

    }

  </script>

</body>
</html>
